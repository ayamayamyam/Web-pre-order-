<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kamus Sastra Indonesia: Pesan Sekarang</title>
<meta name="description" content="Kamus Sastra Indonesia: rangkuman istilah, genre, dan teori sastra. Tersedia 2 edisi & pilihan kualitas kertas, pesan langsung via WhatsApp.">
<style>
  :root{
    --navy:#14213d; --navy-tua:#0d1730; --emas:#d4af6a; --emas-tua:#b8924a;
    --krem:#faf6ef; --teks:#22293d; --redup:#6b7280; --hijau:#1e9e57; --putih:#ffffff;
  }
  *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',system-ui,sans-serif}
  body{background:var(--krem);color:var(--teks);line-height:1.65}
  header{position:sticky;top:0;z-index:50;background:var(--navy-tua);box-shadow:0 2px 12px rgba(0,0,0,.3)}
  .nav{max-width:1100px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:14px 20px;color:#fff}
  .logo{font-weight:800;font-size:1.1rem;letter-spacing:.5px}
  .logo span{color:var(--emas)}
  .btn-wa{background:var(--hijau);color:#fff;border:none;padding:9px 18px;border-radius:22px;font-weight:700;font-size:.88rem;cursor:pointer;text-decoration:none;transition:.2s}
  .btn-wa:hover{filter:brightness(1.1);transform:translateY(-1px)}

  .hero{max-width:1100px;margin:auto;padding:56px 20px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
  .cover-box{position:relative}
  .cover-box img{width:100%;border-radius:14px;box-shadow:0 24px 50px rgba(20,33,61,.35);display:block;background:#e4ddcf}
  .stok{position:absolute;top:14px;left:14px;background:var(--emas);color:var(--navy-tua);font-weight:800;font-size:.75rem;padding:6px 14px;border-radius:20px;box-shadow:0 4px 10px rgba(0,0,0,.25)}
  .hero-info .label{color:var(--emas-tua);font-weight:700;letter-spacing:2px;text-transform:uppercase;font-size:.78rem}
  .hero-info h1{font-size:2.4rem;color:var(--navy);line-height:1.2;margin:8px 0 14px}
  .hero-info p{color:var(--redup);margin-bottom:22px}
  .harga-box{background:#fff;border-radius:16px;padding:22px;box-shadow:0 8px 24px rgba(20,33,61,.1);border-left:5px solid var(--emas)}
  .harga-box label{font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--redup);display:block;margin-bottom:6px}
  .harga-box select{width:100%;padding:12px 14px;border:1.5px solid #e4ddcf;border-radius:10px;background:var(--krem);font-size:.95rem;cursor:pointer;margin-bottom:14px}
  .edisi-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
  .edisi-card{border:1.5px solid #e4ddcf;border-radius:10px;padding:10px 8px;text-align:center;cursor:pointer;transition:.15s}
  .edisi-card.active{border-color:var(--navy);background:var(--krem);box-shadow:0 2px 8px rgba(20,33,61,.12)}
  .edisi-card .dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:middle}
  .edisi-card .nm{font-weight:800;font-size:.88rem;color:var(--navy)}
  .edisi-card .mulai{font-size:.75rem;color:var(--redup)}
  .harga{font-size:2rem;font-weight:800;color:var(--navy)}
  .harga small{display:block;font-size:.75rem;color:var(--redup);font-weight:400}
  .qty-row{display:flex;align-items:center;gap:14px;margin:16px 0}
  .qty-row .qty{display:flex;align-items:center;border:1.5px solid #e4ddcf;border-radius:10px;overflow:hidden}
  .qty button{width:42px;height:42px;border:none;background:var(--krem);font-size:1.2rem;font-weight:700;cursor:pointer;color:var(--navy)}
  .qty span{width:50px;text-align:center;font-weight:800;font-size:1.05rem}
  .btn-pesan{width:100%;background:var(--hijau);color:#fff;border:none;padding:15px;border-radius:12px;font-size:1.05rem;font-weight:800;cursor:pointer;transition:.2s;display:flex;align-items:center;justify-content:center;gap:8px}
  .btn-pesan:hover{filter:brightness(1.1)}
  .note{text-align:center;font-size:.78rem;color:var(--redup);margin-top:10px}

  section{max-width:1100px;margin:auto;padding:48px 20px}
  .sec-title{text-align:center;color:var(--navy);font-size:1.8rem;margin-bottom:6px}
  .sec-sub{text-align:center;color:var(--redup);margin-bottom:34px}
  .paper-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px}
  .paper-card{background:#fff;border-radius:14px;padding:22px;border-top:5px solid var(--emas);box-shadow:0 4px 14px rgba(20,33,61,.07);transition:.2s;cursor:pointer}
  .paper-card:hover,.paper-card.active{transform:translateY(-5px);box-shadow:0 12px 26px rgba(20,33,61,.15);border-top-color:var(--navy)}
  .paper-card .gsm{font-size:.75rem;color:var(--emas-tua);font-weight:800;text-transform:uppercase;letter-spacing:1px}
  .paper-card h3{color:var(--navy);margin:4px 0 6px;font-size:1.02rem}
  .paper-card p{font-size:.84rem;color:var(--redup)}
  .paper-card .prc{margin-top:12px;font-weight:800;color:var(--navy);font-size:1.05rem}

  .fitur-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
  .fitur{background:#fff;border-radius:14px;padding:24px;text-align:center;box-shadow:0 4px 14px rgba(20,33,61,.07)}
  .fitur .ikon{font-size:2.2rem;margin-bottom:10px}
  .fitur h3{color:var(--navy);font-size:1rem;margin-bottom:6px}
  .fitur p{font-size:.85rem;color:var(--redup)}

  .quote{background:var(--navy);border-radius:18px;padding:44px 28px;text-align:center;color:#e8e2d5}
  .quote p{font-style:italic;font-size:1.15rem;max-width:640px;margin:0 auto 10px}
  .quote span{color:var(--emas);font-size:.88rem}

  footer{background:var(--navy-tua);color:#9aa3b8;text-align:center;padding:26px 20px;font-size:.85rem;margin-top:30px}
  footer b{color:var(--emas)}

  .modal{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;background:rgba(13,23,48,.6);padding:20px}
  .modal.show{display:flex}
  .modal-box{background:#fff;border-radius:18px;max-width:460px;width:100%;padding:28px;max-height:90vh;overflow-y:auto}
  .modal-box h2{color:var(--navy);margin-bottom:16px}
  .form-group{margin-bottom:13px}
  .form-group label{font-size:.83rem;font-weight:700;display:block;margin-bottom:5px}
  .form-group input,.form-group textarea,.form-group select{width:100%;padding:11px 14px;border:1.5px solid #e4ddcf;border-radius:10px;font-size:.92rem;font-family:inherit;background:#fff}
  .form-row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .subblok{background:var(--krem);border-radius:12px;padding:14px;margin:10px 0}
  .ringkasan{background:var(--krem);border-radius:12px;padding:14px 16px;margin:12px 0;font-size:.88rem}
  .ringkasan div{display:flex;justify-content:space-between;padding:3px 0}
  .sukses{text-align:center;padding:26px 8px}
  .sukses .ikon{font-size:3.2rem}
  .sukses h2{margin:8px 0 6px}
  .sukses p{color:var(--redup);font-size:.9rem}
  @media(max-width:820px){.hero{grid-template-columns:1fr;padding:36px 20px}.hero-info h1{font-size:1.8rem}.form-row2{grid-template-columns:1fr}}
</style>
</head>
